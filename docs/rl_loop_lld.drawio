    <diagram name="InfraRL RL Loop LLD" id="infrarl-lld">
        <mxGraphModel dx="694" dy="660" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="700" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="InfraRL - env.step() LLD" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontColor=#2d3436;" parent="1" vertex="1">
                    <mxGeometry x="40" y="24" width="700" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="One per-step call. Branches descend to a shared return. Reward fires only at the terminal step." style="text;html=1;fontSize=11;fontStyle=2;align=left;fontColor=#636e72;" parent="1" vertex="1">
                    <mxGeometry x="40" y="58" width="900" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="entry" value="env.step(a_t)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3436;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#2d3436;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="430" y="120" width="220" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="decide" value="terminal step ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3436;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#2d3436;" parent="1" vertex="1">
                    <mxGeometry x="450" y="205" width="180" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="nt1" value="commit a_t&lt;br&gt;&lt;span style=&quot;font-size:9px;font-weight:normal;color:#636e72&quot;&gt;partial_stack[step_type][tier] ← a_t&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b2bec3;fontSize=11;fontStyle=1;fontColor=#2d3436;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="130" y="330" width="240" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="nt2" value="recompute mask_{t+1}&lt;br&gt;&lt;span style=&quot;font-size:9px;font-weight:normal;color:#636e72&quot;&gt;compatibility(partial_stack)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b2bec3;fontSize=11;fontStyle=1;fontColor=#2d3436;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="130" y="396" width="240" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="nt3" value="assemble s_{t+1}&lt;br&gt;&lt;span style=&quot;font-size:9px;font-weight:normal;color:#636e72&quot;&gt;profile ⊕ next_step ⊕ stack&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b2bec3;fontSize=11;fontStyle=1;fontColor=#2d3436;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="130" y="462" width="240" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="t1" value="commit a_t (final step)&lt;br&gt;&lt;span style=&quot;font-size:9px;font-weight:normal;color:#636e72&quot;&gt;stack now complete&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b2bec3;fontSize=11;fontStyle=1;fontColor=#2d3436;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="700" y="330" width="240" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="t2" value="simulator.estimate&lt;br&gt;&lt;span style=&quot;font-size:9px;font-weight:normal;color:#636e72&quot;&gt;(stack, profile) → Q, L_ms, cost&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b2bec3;fontSize=11;fontStyle=1;fontColor=#2d3436;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="700" y="396" width="240" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="t3" value="reward.compose(Q, L_ms, cost, profile)&lt;br&gt;&lt;span style=&quot;font-size:9px;font-weight:normal;color:#d63031&quot;&gt;→ r_T + breakdown · see panel&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d63031;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#d63031;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="700" y="462" width="240" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="ret" value="return ( s_next , r , done , truncated=False , info )&lt;br&gt;&lt;span style=&quot;font-size:9px;font-weight:normal;color:#636e72&quot;&gt;info includes mask_{t+1} on non-terminal, breakdown on terminal&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#2d3436;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#2d3436;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="300" y="580" width="470" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="rw_sum" value="r_T  =  0.4·Q_r  +  0.3·B_r  +  0.2·S_r  +  0.1·E_r" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d63031;strokeColor=#b02424;fontSize=13;fontStyle=1;fontColor=#ffffff;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="120" width="280" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="rw_q" value="&lt;b style=&quot;font-size:12px&quot;&gt;Q_r&lt;/b&gt;  =  clip( Q / acc_req , 0 , 1 )&lt;br&gt;&lt;span style=&quot;font-size:9px;font-style:italic;color:#636e72&quot;&gt;task accuracy vs requirement  ·  weight 0.4&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe6e9;fontSize=11;fontColor=#2d3436;align=left;spacingLeft=14;spacingTop=6;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="198" width="280" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="rw_b" value="&lt;b style=&quot;font-size:12px&quot;&gt;B_r&lt;/b&gt;  =  1[ cost ≤ budget ] + 0.1·max( 0 , (budget − cost) / budget )&lt;br&gt;&lt;span style=&quot;font-size:9px;font-style:italic;color:#636e72&quot;&gt;binary compliance + capped savings bonus  ·  weight 0.3&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe6e9;fontSize=11;fontColor=#2d3436;align=left;spacingLeft=14;spacingTop=6;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="282" width="280" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="rw_s" value="&lt;b style=&quot;font-size:12px&quot;&gt;S_r&lt;/b&gt;  =  1[ L_ms ≤ sla_ms ]&lt;br&gt;&lt;span style=&quot;font-size:9px;font-style:italic;color:#636e72&quot;&gt;binary latency SLA  ·  weight 0.2&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe6e9;fontSize=11;fontColor=#2d3436;align=left;spacingLeft=14;spacingTop=6;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="376" width="280" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="rw_e" value="&lt;b style=&quot;font-size:12px&quot;&gt;E_r&lt;/b&gt;  =  max( 0 , 1 − cost / budget )&lt;br&gt;&lt;span style=&quot;font-size:9px;font-style:italic;color:#636e72&quot;&gt;unused budget headroom  ·  weight 0.1  ·  see ADR 002&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe6e9;fontSize=11;fontColor=#2d3436;align=left;spacingLeft=14;spacingTop=6;arcSize=8;" parent="1" vertex="1">
